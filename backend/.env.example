# =====================================================
# BalanceVault TrustLedger – Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# =====================================================

# ----- Database -----
# Main PostgreSQL connection string for local dev
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/balancevault?sslmode=disable"

# Optional dedicated test database used by Jest
TEST_DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/balancevault_test?sslmode=disable"

# Separate migration role (higher privileges, only used for prisma migrate)
DATABASE_MIGRATION_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/balancevault?sslmode=disable"

# ----- Redis -----
# Upstash Redis (or any Redis provider)
REDIS_URL="redis://:PASSWORD@HOST:PORT"

# ----- JWT -----
JWT_SECRET="change-this-to-a-long-random-string-at-least-64-chars"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="another-long-random-secret-for-refresh-tokens"
JWT_REFRESH_EXPIRES_IN="7d"

# ----- Admin Bootstrap -----
# Used ONCE to create the first admin. Remove after first run or keep disabled.
ADMIN_BOOTSTRAP_ENABLED="false"
ADMIN_BOOTSTRAP_EMAIL="admin@balancevault.internal"
ADMIN_BOOTSTRAP_PASSWORD="ChangeThisImmediately!123"
ADMIN_BOOTSTRAP_FIRST_NAME="System"
ADMIN_BOOTSTRAP_LAST_NAME="Admin"

# ----- App -----
NODE_ENV="development"
PORT=5000
FRONTEND_URL="http://localhost:5173"
API_VERSION="v1"

# ----- Rate Limiting -----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=10

# ----- Security -----
BCRYPT_ROUNDS=12
